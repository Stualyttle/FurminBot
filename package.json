{
  "name": "furmin-bot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "update-commands": "node dist/src/main.js --deploy-commands",
    "dev": "tsc -w",
    "dev:start": "node dist/src/main.js",
    "dev:test": "jest -i",
    "setup": "npm run build && npm run update-commands",
    "docker:setup": "npm run build",
    "docker:build": "docker build -t furmin-bot .",
    "update": "npm update --save && npx npm-check-updates -u && npm install"
  },
  "volta": {
    "node": "24.15.0"
  },
  "engines": {
    "node": "24.15.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "eslint": "^9.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
